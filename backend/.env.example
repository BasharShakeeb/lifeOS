# ============================================================================
# LifeOS FastAPI Backend - Environment Variables
# Copy this file to `.env` and fill in the real values.
# ============================================================================

# Supabase project URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Settings > API > Project API keys > anon public)
SUPABASE_ANON_KEY=your_anon_public_key

# Legacy JWT secret (HS256) - only needed if your project still issues
# HS256 tokens. Projects migrated to the new JWT Signing Keys (ES256) are
# verified automatically via the public JWKS endpoint and can leave this empty.
# (Settings > JWT Keys > Legacy JWT Secret > Reveal)
SUPABASE_JWT_SECRET=

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
